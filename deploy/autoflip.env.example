HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/autoflip/autoflip.sqlite3

# Keep registration closed until the public launch checklist is complete.
PUBLIC_REGISTRATION_ENABLED=false
BETA_TESTER_VK_IDS=
ADMIN_PLAYER_IDS=

# Generate on the server with: openssl rand -hex 32
SECURITY_HASH_SECRET=replace-with-a-random-secret

# Fill these only after the YooKassa shop is approved and HTTPS is enabled.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPTS_ENABLED=false
YOOKASSA_VAT_CODE=1
